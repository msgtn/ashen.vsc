  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "#737373"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#DF6464"
      }
    },
    {
      "name": "Character",
      "scope": "constant.character",
      "settings": {
        "foreground": "#DF6464"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#68bebeff"
      }
    },
    {
      "name": "Boolean",
      "scope": "constant.language.boolean",
      "settings": {
        "foreground": "#4A8B8B"
      }
    },
    {
      "name": "Constant",
      "scope": ["constant", "constant.language", "support.constant"],
      "settings": {
        "foreground": "#C4693D"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "keyword.other"],
      "settings": {
        "foreground": "#B14242"
      }
    },
    {
      "name": "Keyword Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#D87C4A"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#B14242"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#C4693D"
      }
    },
    {
      "name": "Function",
      "scope": [
        // "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#C4693D"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
      ],
      "settings": {
        "foreground": "#87E498"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#b4b4b4"
      }
    },
    {
      "name": "Variable Language",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#6E98CF"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": {
        "foreground": "#EEBC4C"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#d5d5d5"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#d5d5d5"
      }
    },
    {
      "name": "Punctuation Bracket",
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#737373"
      }
    },
    {
      "name": "Punctuation Delimiter",
      "scope": [
        "punctuation.separator.comma",
        "punctuation.separator.colon",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#E49A44"
      }
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#D87C4A"
      }
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#949494"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#a7a7a7"
      }
    },
    {
      "name": "Namespace",
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": {
        "foreground": "#C4693D"
      }
    },
    {
      "name": "Preprocessor",
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": {
        "foreground": "#B14242"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#C53030"
      }
    },
    {
      "name": "Markup Heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#B14242",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Bold",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Italic",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Underline",
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup Strikethrough",
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup Inserted",
      "scope": ["markup.inserted", "punctuation.definition.inserted"],
      "settings": {
        "foreground": "#a7a7a7"
      }
    },
    {
      "name": "Markup Deleted",
      "scope": ["markup.deleted", "punctuation.definition.deleted"],
      "settings": {
        "foreground": "#B14242"
      }
    },
    {
      "name": "Markup Changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#E49A44"
      }
    },
    {
      "name": "Diff Header",
      "scope": ["meta.diff.header", "meta.diff.index"],
      "settings": {
        "foreground": "#4A8B8B"
      }
    },
    {
      "name": "Diff Added",
      "scope": ["meta.diff.header.to-file", "punctuation.definition.to-file"],
      "settings": {
        "foreground": "#a7a7a7"
      }
    },
    {
      "name": "Diff Removed",
      "scope": [
        "meta.diff.header.from-file",
        "punctuation.definition.from-file"
      ],
      "settings": {
        "foreground": "#B14242"
      }
    },
    {
      "name": "JSON Key",
      "scope": [
        "support.type.property-name.json",
        "string.json support.type.property-name"
      ],
      "settings": {
        "foreground": "#d5d5d5"
      }
    },
    {
      "name": "Emphasis",
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strong",
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Error Token",
      "scope": "token.error-token",
      "settings": {
        "foreground": "#C53030"
      }
    },
    {
      "name": "Warning Token",
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#E5A72A"
      }
    },
    {
      "name": "Info Token",
      "scope": "token.info-token",
      "settings": {
        "foreground": "#4A8B8B"
      }
    },
    {
      "name": "Debug Token",
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#949494"
      }
    }
  ]
}
